# UpliftBench harness credentials (copy to .env, never commit .env)
#
# OpenAI-compatible endpoint used by the `openai-compat` harness.
# Any provider that speaks /chat/completions with function calling works.
UPLIFT_BASE_URL=https://api.openai.com/v1
UPLIFT_API_KEY=sk-...
#
# Default model id used when --model is omitted. Must be an exact id,
# never `latest` (protocol/1.0.0 §2).
UPLIFT_MODEL=gpt-4o-mini
#
# Safety valve for `uplift run` (docs/06 §3).
UPLIFT_MAX_COST=10
